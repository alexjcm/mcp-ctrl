{
  "name": "mcp-ctrl",
  "version": "1.0.0",
  "description": "Interactive CLI for managing local stdio MCP configurations",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --external @iarna/toml --external @clack/prompts --external commander --external jsonc-parser",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bin": {
    "mcp-ctrl": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.8.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "commander": "^15.0.0"
  }
}
